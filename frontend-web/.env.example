# Copiar a .env y completar con los valores reales del proyecto de
# Supabase (Project Settings → API). SIEMPRE la clave "anon" pública acá
# — nunca la service_role (esa es solo para backend-server, del lado
# del servidor).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# URL donde corre backend-server (ver backend-server/README.md) — solo se
# usa para lo que necesita service_role del lado del servidor (alta de
# operador con PIN+invitación, reseteo de PIN, aprobar/rechazar
# autoregistro). En dev local suele ser http://localhost:8090.
VITE_BACKEND_URL=http://localhost:8090

