# Copiar a .env y completar. Nunca commitear el .env real.

# --- Identidad de esta consola ---
# El id real de la fila en `consolas` (Supabase) — es también el usuario
# MQTT (ver backend-server/README, "Autenticación de las consolas contra
# Mosquitto"). Provisionar con backend-server/scripts/provisionar-consola.sh.
CONSOLA_ID=

# --- Broker MQTT ---
MQTT_URL=mqtt://localhost:1883
# La contraseña que dio provisionar-consola.sh para este CONSOLA_ID.
MQTT_PASSWORD=

# --- Hardware ---
# EN_PI=1 activa los drivers reales de GPIO (relé + botonera) en vez de los
# simulados. NUNCA poner esto en 1 fuera de la Raspberry Pi real — instancia
# GPIO real. Vacío/0 = simulado (relé por consola, botonera por teclado).
EN_PI=
# Solo si EN_PI=1 — número de pin BCM de cada uno (default razonable si se
# omite, ver src/index.ts).
RELE_PIN=17
PIN_BOTON_DISPARADO=27
PIN_BOTON_OK=22
PIN_BOTON_CANCELAR=23
