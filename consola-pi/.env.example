# Copiar a .env y completar. Nunca commitear el .env real.

# --- Identidad de esta consola ---
# El id real de la fila en `consolas` (Supabase) — es también el usuario
# MQTT (ver backend-server/README, "Autenticación de las consolas contra
# Mosquitto"). Provisionar con backend-server/scripts/provisionar-consola.sh.
CONSOLA_ID=

# --- Broker MQTT ---
MQTT_URL=mqtt://localhost:1883
# La contraseña que dio provisionar-consola.sh para este CONSOLA_ID.
MQTT_PASSWORD=

# --- Hardware (ESP32, ver README "Corrección de arquitectura") ---
# EN_PI=1 abre el puerto serie real hacia el ESP32 en vez del cliente
# simulado por teclado. NUNCA poner esto en 1 fuera de la Raspberry Pi
# real. Vacío/0 = simulado (botones por teclado, lámparas/relé logueados).
EN_PI=
# Solo si EN_PI=1 — puerto serie y baudrate del ESP32.
ESP32_PUERTO=/dev/serial0
ESP32_BAUD=115200

# --- Cache local del padrón (SQLite, ver README invariante 2) ---
PADRON_DB_PATH=./padron.db

# --- Pantalla táctil ---
PUERTO_PANTALLA=8080
# REAL o SIMULACRO — cómo se marcan los eventos que dispare esta consola.
MODO_EVENTO=REAL
