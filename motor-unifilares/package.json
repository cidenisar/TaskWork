{
  "name": "motor-unifilares",
  "version": "0.1.0",
  "description": "Motor generador de unifilares — recibe circuitos de tablero (JSON) y devuelve el plano en DXF/PDF, interpretando con IA según REGLAS_UNIFILAR.md. Servicio HTTP aparte, para que informes-app lo llame por un botón sin acoplar el motor a su deploy.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ensenar": "tsx scripts/ensenar.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.112.4",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19",
    "@vercel/node": "^27.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
