# Copiar a .env y completar. Todo lo que empieza con EXPO_PUBLIC_ queda
# embebido en el bundle de la app (visible para cualquiera que la
# instale) — mismo criterio que frontend-web/.env.example con la
# anon key: acá tampoco va NUNCA una clave sensible (nada de
# service_role ni de credenciales de Firebase Admin).

# Mismo proyecto de Supabase que usan backend-server y frontend-web —
# la URL y la clave anon son públicas por diseño.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL pública de backend-server (donde corra: local, un túnel, o el
# deploy real) — POST /personas/reclamar|autoregistro|canjear-codigo|
# push-token y POST /confirmaciones pasan por acá.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8090
