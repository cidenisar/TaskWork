# Copiar a .env y completar con los valores reales. Nunca commitear el .env real.

# --- Supabase ---
# URL del proyecto (Project Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role key (Project Settings > API > service_role secret).
# NUNCA exponer esta clave a la Pi, al teléfono ni al navegador — es exclusiva
# de este servidor. Bypasea RLS por completo (ver 03-backend-online.md,
# sección "Modelo de datos y hosting de desarrollo").
SUPABASE_SERVICE_ROLE_KEY=

# --- Broker MQTT ---
# En desarrollo, un Mosquitto local (mosquitto -v) alcanza. En producción,
# ver "Próximos pasos" de la ficha: broker propio o gestionado, con TLS y
# autenticación por consola.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
