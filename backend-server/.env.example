# Copiar a .env y completar con los valores reales. Nunca commitear el .env real.

# --- Supabase ---
# URL del proyecto (Project Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role key (Project Settings > API > service_role secret).
# NUNCA exponer esta clave a la Pi, al teléfono ni al navegador — es exclusiva
# de este servidor. Bypasea RLS por completo (ver 03-backend-online.md,
# sección "Modelo de datos y hosting de desarrollo").
SUPABASE_SERVICE_ROLE_KEY=

# --- Broker MQTT ---
# En desarrollo, un Mosquitto local (mosquitto -v) alcanza. En producción,
# ver "Próximos pasos" de la ficha: broker propio o gestionado, con TLS y
# autenticación por consola.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- HTTP (Mobile) ---
# Puerto donde escucha POST /confirmaciones — canal de Mobile ("estoy bien"/
# "necesito ayuda"), ver README "Endpoint para las confirmaciones de
# Mobile". En producción va detrás de un proxy con TLS y autenticación (ver
# "Decisiones pendientes" del README — todavía sin elegir).
HTTP_PORT=8090

# --- Despacho: push (Firebase Cloud Messaging) ---
# Service Account de Firebase (Project Settings > Service Accounts >
# Generate new private key, en la consola de Firebase). Sin esto, el
# despacho por push falla (loguea el error) pero el resto del backend
# sigue funcionando — ver README, "Despacho real de push/SMS".
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# El valor de "private_key" del JSON, tal cual (con los "\n" literales).
FIREBASE_PRIVATE_KEY=

# --- Despacho: SMS (Twilio) ---
# Credenciales de console.twilio.com + el número habilitado para enviar
# (formato E.164, ej. +5493514000000). Mismo comportamiento que Firebase
# si falta: falla el despacho por SMS, no tumba el servidor.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
